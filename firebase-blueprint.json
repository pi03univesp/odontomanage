{
  "entities": {
    "User": {
      "title": "User",
      "description": "Dentist or staff member",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "dentist", "staff"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Clinic patient",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["name"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled dental appointment",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "dentistId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" }
      },
      "required": ["patientId", "dentistId", "startTime", "endTime", "status"]
    },
    "Material": {
      "title": "Material",
      "description": "Dental supply or material",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "averageConsumption": { "type": "number" }
      },
      "required": ["name", "unit", "currentStock", "minStock"]
    },
    "InventoryLog": {
      "title": "InventoryLog",
      "description": "Record of material usage or addition",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string", "enum": ["consumption", "addition"] },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["materialId", "quantity", "type", "date", "userId"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient records"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Appointment schedule"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Inventory items"
    },
    "/inventoryLogs/{logId}": {
      "schema": "InventoryLog",
      "description": "Inventory movement logs"
    }
  }
}
